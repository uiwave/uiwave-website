---
import { cn } from '@/lib/utils';

interface Props {
  id: string;
  initialSql: string;
  placeholder?: string;
  showReset?: boolean;
  runLabel?: string;
  minHeight?: string;
  class?: string;
  statusText?: string;
}

const {
  id,
  initialSql,
  placeholder = 'Escribe tu consulta SQL aquí…',
  showReset = true,
  runLabel = 'Ejecutar',
  minHeight = 'min-h-56',
  class: className,
  statusText,
} = Astro.props;
---

<div
  id={id}
  data-sql-workbench
  data-initial-sql={initialSql}
  data-placeholder={placeholder}
  data-show-reset={String(showReset)}
  data-min-height={minHeight}
  class:list={['overflow-hidden rounded-xl border border-border bg-card shadow-sm', className]}
>
  <div class="flex items-center justify-between gap-2 border-b border-border bg-muted/40 px-4 py-2">
    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">SQL</span>
    <div class="flex items-center gap-2">
      {showReset && (
        <button
          type="button"
          data-wb-reset
          class="inline-flex h-8 items-center rounded-md border border-border px-3 text-xs font-medium hover:bg-accent hover:text-accent-foreground"
        >
          Reiniciar
        </button>
      )}
      <button
        type="button"
        data-wb-run
        class="inline-flex h-8 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
          <path d="M6 4.5v15l13-7.5-13-7.5Z" />
        </svg>
        {runLabel}
        <span class="hidden sm:inline text-primary-foreground/70">(Ctrl+Enter)</span>
      </button>
    </div>
  </div>
  <div data-wb-editor class={cn('bg-card', minHeight)}></div>
  <div data-wb-status class="min-h-7 border-t border-border bg-muted/30 px-4 py-1.5 text-xs text-muted-foreground">
    {statusText}
  </div>
  <div data-wb-result class="bg-card p-4"></div>
</div>

<script>
  import { createPlayground } from '@/lib/sql/playground';
  import type { SqlPlayground } from '@/lib/sql/playground';

  document
    .querySelectorAll<HTMLElement>('[data-sql-workbench]')
    .forEach((root) => {
      const editorElement = root.querySelector<HTMLElement>('[data-wb-editor]');
      const runButton = root.querySelector<HTMLElement>('[data-wb-run]');
      const resetButton = root.querySelector<HTMLElement>('[data-wb-reset]');
      const resultElement = root.querySelector<HTMLElement>('[data-wb-result]');
      const statusElement = root.querySelector<HTMLElement>('[data-wb-status]');
      if (!editorElement || !resultElement) return;

      const showReset = root.dataset.showReset !== 'false';

      const playground: SqlPlayground = createPlayground({
        id: root.id,
        editorElement,
        initialSql: root.dataset.initialSql ?? '',
        placeholder: root.dataset.placeholder,
        runButton,
        resetButton: showReset ? resetButton : null,
        resultElement,
        statusElement,
        onRun: (sql, execution) => {
          root.dispatchEvent(
            new CustomEvent('wb-run', {
              detail: { sql, execution },
            }),
          );
        },
      });

      root.addEventListener('wb-set-value', ((event: CustomEvent<string>) => {
        playground.setValue(event.detail);
      }) as EventListener);

      root.addEventListener('wb-run-request', (() => {
        void playground.run();
      }) as EventListener);

      root.addEventListener('wb-set-running', ((event: CustomEvent<boolean>) => {
        playground.setRunning(event.detail);
      }) as EventListener);
    });
</script>