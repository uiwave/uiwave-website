---
import SqlWorkbench from '@/components/SqlWorkbench.astro';
import Badge from '@/components/ui/Badge.astro';
import type { exercise } from '@/lib/schema';

interface Props {
  exercise: typeof exercise.$inferSelect;
  index: number;
  solved: boolean;
  authenticated: boolean;
}

const { exercise: item, index, solved, authenticated } = Astro.props;

const difficultyLabel = {
  easy: 'Fácil',
  medium: 'Media',
  hard: 'Difícil',
}[item.difficulty];

const difficultyVariant = {
  easy: 'default',
  medium: 'warning',
  hard: 'destructive',
}[item.difficulty] as 'default' | 'warning' | 'destructive';
---

<section
  data-exercise
  data-exercise-id={item.id}
  id={`exercise-${item.id}`}
  data-solved={String(solved)}
  class="scroll-mt-24 rounded-xl border border-border bg-card shadow-sm"
  aria-label={`Ejercicio ${index}`}
>
  <header class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-6 py-4">
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-sm font-bold text-primary">
        {index}
      </span>
      <h3 class="text-base font-semibold">{item.title}</h3>
    </div>
    <div class="flex items-center gap-2">
      <Badge variant={difficultyVariant}>{difficultyLabel}</Badge>
      {solved && <Badge variant="success">Resuelto</Badge>}
      <Badge data-solved-badge variant="success" class="hidden">¡Resuelto!</Badge>
    </div>
  </header>

  <div class="space-y-4 px-6 py-5">
    <p class="text-sm leading-relaxed text-foreground">{item.prompt}</p>

    {authenticated ? (
      <>
        <SqlWorkbench
          id={`exercise-${item.id}`}
          initialSql={''}
          placeholder="Escribe tu solución aquí…"
          minHeight="min-h-40"
          statusText="Escribe tu consulta y pulsa Ejecutar o Ctrl+Enter."
        />
        <div data-exercise-feedback class="hidden">
          <div data-feedback-inner></div>
        </div>
      </>
    ) : (
      <div class="rounded-lg border border-dashed border-border bg-muted/30 p-4 text-sm text-muted-foreground">
        <a href="/login" class="font-medium text-primary hover:underline">Inicia sesión</a> para resolver este ejercicio y registrar tu progreso.
      </div>
    )}
  </div>
</section>

<script>
  const { escapeHtml, renderResultTable } = await import('@/lib/sql/render');

  document.querySelectorAll<HTMLElement>('[data-exercise]').forEach((root) => {
    const exerciseId = root.dataset.exerciseId;
    const workbench = root.querySelector<HTMLElement>('[data-sql-workbench]');
    const feedback = root.querySelector<HTMLElement>('[data-exercise-feedback]');
    const feedbackInner = root.querySelector<HTMLElement>('[data-feedback-inner]');
    const solvedBadge = root.querySelector<HTMLElement>('[data-solved-badge]');
    if (!workbench || !feedback || !feedbackInner || !exerciseId) return;

    const renderFeedback = (payload: {
      correct: boolean;
      error?: string | null;
      result?: { columns: string[]; rows: unknown[][] } | null;
      expected?: { columns: string[]; rows: unknown[][] } | null;
      explanation?: string | null;
    }) => {
      feedback.classList.remove('hidden');

      if (payload.error) {
        feedbackInner.innerHTML = `
          <div class="flex items-start gap-3 rounded-lg border border-destructive/40 bg-destructive/10 p-4">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 shrink-0 text-destructive" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="m15 9-6 6" />
              <path d="m9 9 6 6" />
            </svg>
            <div>
              <p class="font-medium text-destructive">Error SQL</p>
              <p class="mt-1 text-sm text-muted-foreground">${escapeHtml(payload.error)}</p>
            </div>
          </div>`;
        return;
      }

      if (payload.correct) {
        feedbackInner.innerHTML = `
          <div class="flex items-start gap-3 rounded-lg border border-success/40 bg-success/10 p-4">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 shrink-0 text-success" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="m9 12 2 2 4-4" />
            </svg>
            <div class="w-full">
              <p class="font-medium text-success">¡Correcto! Tu consulta produce el resultado esperado.</p>
              ${payload.explanation ? `<p class="mt-2 rounded-md bg-card/60 p-3 text-sm text-muted-foreground">${escapeHtml(payload.explanation)}</p>` : ''}
            </div>
          </div>`;
        root.dataset.solved = 'true';
        if (solvedBadge) solvedBadge.classList.remove('hidden');
        window.dispatchEvent(new CustomEvent('exercise-solved', { detail: { exerciseId } }));
        return;
      }

      const expected = payload.expected;
      const actual = payload.result;
      const expectedPreview = document.createElement('div');
      if (expected) renderResultTable(expectedPreview, expected);
      const actualPreview = document.createElement('div');
      if (actual) renderResultTable(actualPreview, actual);

      feedbackInner.innerHTML = `
        <div class="flex items-start gap-3 rounded-lg border border-amber-500/40 bg-amber-500/10 p-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 shrink-0 text-amber-600 dark:text-amber-400" aria-hidden="true">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
          </svg>
          <div>
            <p class="font-medium text-amber-600 dark:text-amber-400">Casi lo tienes. El resultado no coincide con el esperado.</p>
            <p class="mt-1 text-sm text-muted-foreground">Revisa las columnas devueltas, los filtros y el orden de tu consulta.</p>
          </div>
        </div>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Resultado esperado</p>
            ${expectedPreview.innerHTML || '<p class="text-sm text-muted-foreground">Sin filas</p>'}
          </div>
          <div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Tu resultado</p>
            ${actualPreview.innerHTML || '<p class="text-sm text-muted-foreground">Sin filas</p>'}
          </div>
        </div>`;
    };

    workbench.addEventListener('wb-run', async (event) => {
      const detail = (event as CustomEvent).detail as { sql: string };
      feedback.classList.add('hidden');
      try {
        const response = await fetch(`/api/exercises/${exerciseId}/attempt`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sql: detail.sql }),
        });
        const payload = await response.json();
        if (!response.ok) {
          renderFeedback({ correct: false, error: payload.error ?? 'Error al comprobar la solución.' });
          return;
        }
        renderFeedback(payload);
      } catch (err) {
        renderFeedback({ correct: false, error: 'Error de red al comprobar la solución.' });
      }
    });
  });
</script>